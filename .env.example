# ── 平台配置（本文件只放占位值，真实值放本地 .env —— .env 已在 .gitignore 里）──
#
# 用法：cp .env.example .env 然后填真实值；或者由启动脚本 export。

# ── 模型网关（M1-04）────────────────────────────────────────────────
# 换模型 / 换供应商 = 只改下面三行，不用改代码
DEEPSEEK_API_KEY=sk-xxx_把这里换成真实值
LLM_BASE_URL=https://api.deepseek.com
# 按你账号可用的模型名填；本机实测可用的是 deepseek-v4-flash（公共文档里常见的是 deepseek-chat）
LLM_MODEL=deepseek-chat
# 超时（秒）/ 最大尝试次数（只对连接类错误重试）/ 每分钟限流上限（0 = 关闭）
LLM_TIMEOUT=30
LLM_MAX_ATTEMPTS=2
LLM_RATE_LIMIT_PER_MIN=0

# ── 数据智能内核 ────────────────────────────────────────────────────
KERNEL_BASE_URL=http://127.0.0.1:18080
KERNEL_TIMEOUT=15
KERNEL_RETRIES=1

# ── 平台 ────────────────────────────────────────────────────────────
AUTH_MODE=dev
REPORT_PROXY_ENABLED=true

# ── 审计与会话库（dip-pg）──────────────────────────────────────────
DIP_PG_DSN=postgresql://dip:xxx@127.0.0.1:15432/dip

# ── 可选：内核冒烟测试用（指向内核仓库里的演示 SQL）────────────────
# LINEAGE_DEMO_SQL=<内核仓库>/examples/warehouse/ads/t_ads_产销存月报.sql
